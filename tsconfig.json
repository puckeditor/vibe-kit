{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
